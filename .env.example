# Copy to .env and fill in

# DeepInfra: provider for the LLM judges
DEEPINFRA_API_KEY=

# Optional: override the judge endpoint (defaults to DeepInfra's OpenAI-compatible API).
# JUDGE_BASE_URL=https://api.deepinfra.com/v1/openai

# HuggingFace token needed for gated datasets (MHJ, WildJailbreak).
# HF_TOKEN=

# Optional: local clone path for SafeDialBench (GitHub-only; defaults to ./.cache).
# SAFEDIALBENCH_DIR=/path/to/SafeDialBench-Dataset